#!/usr/bin/env bash

# tmux launcher

base_session=${1:-0}

# Exact matching keeps "work" distinct from "work-old".
if ! tmux has-session -t "=$base_session" 2>/dev/null; then
    exec tmux new-session -s "$base_session"
fi

if [[ -n ${TMUX:-} ]]; then
    exec tmux switch-client -t "=$base_session"
fi

# Each client gets a grouped session, so it can select windows independently.
# Let tmux allocate the name, and only clean up the session we created.
base_id=$(tmux display-message -p -t "=$base_session" '#{session_id}') || exit
session_id=$(tmux new-session -d -P -F '#{session_id}' -t "$base_id") || exit
trap 'tmux kill-session -t "$session_id" 2>/dev/null' EXIT
tmux attach-session -t "$session_id"
